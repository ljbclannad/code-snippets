<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lx.governance.vectormemory.mapper.AiGroupMemoryReviewAuditMapper">

    <resultMap id="BaseResultMap" type="com.lx.governance.vectormemory.entity.AiGroupMemoryReviewAuditEntity">
        <id column="id" property="id"/>
        <result column="candidate_id" property="candidateId"/>
        <result column="customer_id" property="customerId"/>
        <result column="group_id" property="groupId"/>
        <result column="action_type" property="actionType"/>
        <result column="result_status" property="resultStatus"/>
        <result column="reviewer" property="reviewer"/>
        <result column="resolution_reason" property="resolutionReason"/>
        <result column="remarks" property="remarks"/>
        <result column="related_formal_id" property="relatedFormalId"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <insert id="insert" parameterType="com.lx.governance.vectormemory.entity.AiGroupMemoryReviewAuditEntity" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO b_ai_group_memory_review_audit (
            candidate_id, customer_id, group_id, action_type, result_status,
            reviewer, resolution_reason, remarks, related_formal_id
        ) VALUES (
            #{candidateId}, #{customerId}, #{groupId}, #{actionType}, #{resultStatus},
            #{reviewer}, #{resolutionReason}, #{remarks}, #{relatedFormalId}
        )
    </insert>

    <select id="selectByCandidateId" resultMap="BaseResultMap">
        SELECT * FROM b_ai_group_memory_review_audit
        WHERE candidate_id = #{candidateId}
        ORDER BY create_time DESC
    </select>
</mapper>
