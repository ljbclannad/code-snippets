<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lx.governance.vectormemory.mapper.AiGroupMemoryConflictMapper">

    <resultMap id="BaseResultMap" type="com.lx.governance.vectormemory.entity.AiGroupMemoryConflictEntity">
        <id column="id" property="id"/>
        <result column="customer_id" property="customerId"/>
        <result column="group_id" property="groupId"/>
        <result column="candidate_id" property="candidateId"/>
        <result column="conflict_target_type" property="conflictTargetType"/>
        <result column="conflict_target_id" property="conflictTargetId"/>
        <result column="conflict_reason" property="conflictReason"/>
        <result column="conflict_score" property="conflictScore"/>
        <result column="resolution_status" property="resolutionStatus"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <insert id="insert" parameterType="com.lx.governance.vectormemory.entity.AiGroupMemoryConflictEntity" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO b_ai_group_memory_conflict (
            customer_id, group_id, candidate_id, conflict_target_type, conflict_target_id,
            conflict_reason, conflict_score, resolution_status
        ) VALUES (
            #{customerId}, #{groupId}, #{candidateId}, #{conflictTargetType}, #{conflictTargetId},
            #{conflictReason}, #{conflictScore}, #{resolutionStatus}
        )
    </insert>

    <select id="selectByCandidateId" resultMap="BaseResultMap">
        SELECT * FROM b_ai_group_memory_conflict
        WHERE candidate_id = #{candidateId}
        ORDER BY create_time DESC
    </select>

    <update id="updateResolutionStatus">
        UPDATE b_ai_group_memory_conflict
        SET resolution_status = #{resolutionStatus},
            update_time = NOW()
        WHERE id = #{id}
    </update>
</mapper>
