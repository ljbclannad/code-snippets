<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.idgendemo.order.OrderMapper">

  <resultMap id="OrderMap" type="com.example.idgendemo.order.Order">
    <id column="id" property="id"/>
    <result column="user_id" property="userId"/>
    <result column="amount" property="amount"/>
    <result column="status" property="status"/>
    <result column="create_time" property="createTime"/>
  </resultMap>

  <insert id="insert" parameterType="com.example.idgendemo.order.Order">
    INSERT INTO t_order (id, user_id, amount, status, create_time)
    VALUES (#{id}, #{userId}, #{amount}, #{status}, #{createTime})
  </insert>

  <select id="selectById" resultMap="OrderMap">
    SELECT id, user_id, amount, status, create_time
    FROM t_order
    WHERE id = #{id}
  </select>

</mapper>
